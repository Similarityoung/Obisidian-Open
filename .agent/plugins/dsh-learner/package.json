{
  "name": "@local/dsh-learner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把 Learning/ 学习状态接入 DSH：左侧学习看板、概念掌握度和按需读取的学习上下文。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/**/*.js",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
